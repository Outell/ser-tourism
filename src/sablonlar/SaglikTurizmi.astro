---
// Sağlık turizmi — turlar bölümü altında yaşayan ortak sayfa, Ramses Ink ile
// aynı desen: fiyat/iptal politikası bloğu yok (§11 "boş alan sessizdir"),
// tek aksiyon WhatsApp, klinik ismi/logo/konum yok. Ramses'ten farkı: tek
// hizmet değil dört alt kategori (saç ekimi, diş, göz, estetik) olduğu için
// bir "hizmetler" ızgarası var; yorum bloğu yok (yeni hizmet, henüz gerçek
// referans yok) — onun yerine doğrulanabilir genel güven maddeleri var.
// Sonuç galerisi iki ayrı başlıklı gruptan oluşuyor: diş tedavisi + rinoplasti.
// Sonuç galerisi iki gruptan oluşuyor (diş tedavisi, rinoplasti) — bkz.
// saglikTurizmi.ts üstündeki not: saç ekimi galerisi kasıtlı olarak yok,
// o kaynak görseller kimliği belli ediyordu. Işık kutusu tek bir düz dizi
// üzerinde çalışıyor; her grup kendi başlangıç indeksinden (galeriOfset)
// başlıyor ki tek bir dialog iki grubu da gezebilsin.
import type { Dil } from '../lib/tipler';
import TemelSayfa from '../layouts/TemelSayfa.astro';
import WaIkon from '../components/WaIkon.astro';
import { MARKA, SAGLIK_WA_NUMBERS } from '../config/marka';
import { sozluk } from '../i18n/sozluk';
import { anaUrl, turlarUrl } from '../lib/rotalar';
import { SAGLIK_KART_GORSEL, SAGLIK_SONUC_GRUPLARI, SAGLIK_KATEGORILER } from '../data/saglikTurizmi';

interface Props {
  dil: Dil;
  alternatifler: Record<Dil, string>;
}

const { dil, alternatifler: alt } = Astro.props;
const s = sozluk[dil];
const numara = SAGLIK_WA_NUMBERS[dil];

function waLinkUret(konu: string) {
  const mesaj = [s.m_selamlama, '', konu, '', s.m_kapanis].join('\n');
  return `https://wa.me/${numara}?text=${encodeURIComponent(mesaj)}`;
}

const anaWaLink = waLinkUret(s.saglik_wa_konu);

const kategoriIcerik: Record<string, { baslik: string; metin: string; konu: string }> = {
  sac: { baslik: s.saglik_kat_sac_baslik, metin: s.saglik_kat_sac_metin, konu: s.saglik_wa_konu_sac },
  dis: { baslik: s.saglik_kat_dis_baslik, metin: s.saglik_kat_dis_metin, konu: s.saglik_wa_konu_dis },
  goz: { baslik: s.saglik_kat_goz_baslik, metin: s.saglik_kat_goz_metin, konu: s.saglik_wa_konu_goz },
  estetik: { baslik: s.saglik_kat_estetik_baslik, metin: s.saglik_kat_estetik_metin, konu: s.saglik_wa_konu_estetik },
};

const hizmetler = SAGLIK_KATEGORILER.map((k) => {
  const icerik = kategoriIcerik[k.kod];
  return { ...k, ...icerik, waLink: waLinkUret(icerik.konu) };
});

const adimlar = [
  { baslik: s.saglik_adim1_baslik, metin: s.saglik_adim1_metin },
  { baslik: s.saglik_adim2_baslik, metin: s.saglik_adim2_metin },
  { baslik: s.saglik_adim3_baslik, metin: s.saglik_adim3_metin },
  { baslik: s.saglik_adim4_baslik, metin: s.saglik_adim4_metin },
];

const guvenler = [
  { baslik: s.saglik_guven1_baslik, metin: s.saglik_guven1_metin },
  { baslik: s.saglik_guven2_baslik, metin: s.saglik_guven2_metin },
  { baslik: s.saglik_guven3_baslik, metin: s.saglik_guven3_metin },
  { baslik: s.saglik_guven4_baslik, metin: s.saglik_guven4_metin },
];

const galeriBasliklari: Record<string, string> = {
  sac: s.saglik_galeri_sac_baslik,
  dis: s.saglik_galeri_baslik,
  rinoplasti: s.saglik_galeri_rinoplasti_baslik,
};

// Düz galeri dizisi (ışık kutusu için) + her grubun bu dizideki başlangıç indeksi
const tumGaleriGorselleri = SAGLIK_SONUC_GRUPLARI.flatMap((g) => g.gorseller);
let ofset = 0;
const galeriGruplari = SAGLIK_SONUC_GRUPLARI.map((g) => {
  const baslangic = ofset;
  ofset += g.gorseller.length;
  return { ...g, baslik: galeriBasliklari[g.kod], baslangic };
});

const sayfaBaslik = `${s.saglik_baslik} | ${MARKA}`;
---
<TemelSayfa dil={dil} baslik={sayfaBaslik} aciklama={s.saglik_ozet} alternatifler={alt}>
  <div class="kap">
    <nav class="kirinti" aria-label="breadcrumb">
      <ol>
        <li><a href={anaUrl(dil)}>{s.ana_sayfa}</a></li>
        <li><a href={turlarUrl(dil)}>{s.tum_turlar}</a></li>
        <li>{s.saglik_baslik}</li>
      </ol>
    </nav>

    <div class="saglik-yerlesim bolum--dar">
      <!-- Hero — tek görsel, galeri şeridi yok (Ramses'ten farklı: tek fotoğraf yeterli) -->
      <div class="tur-hero">
        <img
          src={SAGLIK_KART_GORSEL}
          alt={s.saglik_baslik}
          width="1600" height="1200"
          fetchpriority="high" decoding="async"
        />
        <span class="tur-hero__golge" aria-hidden="true"></span>
        <span class="tur-hero__icerik">
          <span class="tur-hero__baslik">{s.saglik_baslik}</span>
          <span class="tur-hero__ozet">{s.saglik_h1_alt}</span>
          <span class="tur-hero__meta">
            <span>{s.saglik_badge_danisma}</span>
            <span>{s.saglik_badge_transfer}</span>
          </span>
        </span>
      </div>

      <!-- Neden Türkiye -->
      <section class="saglik-bolum">
        <h2>{s.saglik_intro_baslik}</h2>
        <p class="ikincil">{s.saglik_intro_metin}</p>
      </section>

      <!-- Hizmetler -->
      <section class="saglik-bolum">
        <h2>{s.saglik_hizmetler_baslik}</h2>
        <div class="hizmet-grid">
          {hizmetler.map((h) => (
            <article class="hizmet-kart">
              <div class="hizmet-kart__gorsel">
                <img src={h.gorsel} alt={h.baslik} width="1200" height="900" loading="lazy" decoding="async" />
              </div>
              <div class="hizmet-kart__govde">
                <h3>{h.baslik}</h3>
                <p class="ikincil">{h.metin}</p>
                <a class="wa-buton wa-buton--kucuk" href={h.waLink} target="_blank" rel="noopener">
                  <WaIkon boyut={14} />
                  WhatsApp
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Sonuç galerileri (diş tedavisi, rinoplasti) — tek ışık kutusu, iki grup -->
      {galeriGruplari.map((grup) => (
        <section class="saglik-bolum" data-galeri>
          <h2>{grup.baslik}</h2>
          <div class="sonuc-grid">
            {grup.gorseller.map((g, i) => (
              <button type="button" class="sonuc-grid__ogr" data-galeri-ac={grup.baslangic + i} aria-label={s.saglik_galeri_alt}>
                <img src={g} alt="" width="1100" height="1100" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </section>
      ))}
      {tumGaleriGorselleri.length > 0 && <p class="saglik-not">{s.saglik_galeri_not}</p>}

      <!-- Nasıl işliyor -->
      <section class="saglik-bolum">
        <h2>{s.saglik_surec_baslik}</h2>
        <ol class="adim-liste">
          {adimlar.map((a, i) => (
            <li>
              <span class="adim-liste__no" aria-hidden="true">{i + 1}</span>
              <h3>{a.baslik}</h3>
              <p class="ikincil">{a.metin}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Bilmeniz gerekenler — yorum yerine doğrulanabilir güven maddeleri -->
      <section class="saglik-bolum">
        <h2>{s.saglik_guven_baslik}</h2>
        <div class="neden">
          {guvenler.map((g) => (
            <article>
              <h3>{g.baslik}</h3>
              <p>{g.metin}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Kapanış CTA — fiyat yok, tek aksiyon WhatsApp -->
      <section class="saglik-cta">
        <h2>{s.saglik_cta_baslik}</h2>
        <p class="ikincil">{s.saglik_cta_metin}</p>
        <a class="wa-buton wa-buton--genis" style="max-width:340px" href={anaWaLink} target="_blank" rel="noopener">
          <WaIkon boyut={18} />
          {s.transfer_cta_wa}
        </a>
      </section>
    </div>
  </div>

  {tumGaleriGorselleri.length > 0 && (
    <dialog class="isik" data-isik aria-label={s.saglik_galeri_alt}>
      <button type="button" class="isik__kapat" data-isik-kapat aria-label={s.galeri_kapat}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <figure class="isik__cerceve">
        <img data-isik-gorsel src={tumGaleriGorselleri[0]} alt={s.saglik_galeri_alt} width="1100" height="1100" />
        <figcaption class="isik__sayac" data-isik-sayac></figcaption>
      </figure>

      <button type="button" class="isik__ok isik__ok--sol" data-isik-yon="-1" aria-label={s.galeri_onceki}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </button>
      <button type="button" class="isik__ok isik__ok--sag" data-isik-yon="1" aria-label={s.galeri_sonraki}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </dialog>
  )}
</TemelSayfa>

<style>
  .saglik-yerlesim{ display: grid; gap: clamp(32px, 5vw, 56px); }

  /* ---- Hero — tek görsel, Ramses/Tur.astro ile aynı .tur-hero deseni ---- */

  .tur-hero{
    position: relative;
    display: block;
    width: 100%;
    min-height: clamp(360px, 50vh, 560px);
    padding: 0;
    border: 0;
    border-radius: var(--r-kart);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow: 0 20px 60px rgba(22,18,43,.16);
  }
  .tur-hero img{
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    filter: saturate(.96) contrast(1.05);
  }
  .tur-hero__golge{
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(22,18,43,.10) 0%, rgba(22,18,43,.36) 46%, rgba(22,18,43,.78) 100%),
      linear-gradient(90deg, rgba(22,18,43,.40) 0%, rgba(22,18,43,.04) 54%);
    pointer-events: none;
  }
  .tur-hero__icerik{
    position: absolute;
    left: clamp(20px, 4vw, 42px);
    right: clamp(20px, 4vw, 42px);
    bottom: clamp(22px, 4vw, 42px);
    display: grid;
    gap: 12px;
    max-width: 720px;
  }
  .tur-hero__baslik{
    display: block;
    font-family: var(--font-baslik);
    font-size: clamp(32px, 4.6vw, 52px);
    line-height: 1.05;
    font-weight: 500;
    color: var(--text-inverse);
  }
  .tur-hero__ozet{
    display: block;
    max-width: 620px;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.55;
    color: rgba(247,243,236,.88);
  }
  .tur-hero__meta{ display: flex; flex-wrap: wrap; gap: 8px; }
  .tur-hero__meta span{
    border-radius: var(--r-rozet);
    background: rgba(247,243,236,.12);
    border: 1px solid rgba(247,243,236,.20);
    color: rgba(247,243,236,.92);
    padding: 7px 10px;
    font-size: 12px;
    backdrop-filter: blur(8px);
  }

  .saglik-bolum h2{ margin-bottom: 16px; }

  /* ---- Hizmetler ızgarası ------------------------------------------- */

  .hizmet-grid{
    display: grid;
    gap: clamp(14px, 2vw, 20px);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .hizmet-kart{
    background: var(--surface-elevated);
    border: 0.5px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .hizmet-kart__gorsel{
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-strong);
  }
  .hizmet-kart__gorsel img{
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(.94) contrast(1.05);
  }
  .hizmet-kart__govde{
    padding: 18px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .hizmet-kart__govde h3{ margin: 0; font-size: 17px; }
  .hizmet-kart__govde p{ margin: 0 0 4px; font-size: 14px; }
  .hizmet-kart__govde .wa-buton{ width: max-content; }

  /* ---- Sonuç galerisi (diş tedavisi) ---------------------------------- */

  .sonuc-grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: clamp(10px, 2vw, 16px);
  }
  .sonuc-grid__ogr{
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--r-media);
    background: var(--surface-strong);
    padding: 0; border: 0;
    display: block; width: 100%;
    cursor: pointer;
  }
  .sonuc-grid__ogr img{
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(.96) contrast(1.04);
    transition: transform .4s ease;
  }
  .sonuc-grid__ogr:hover img{ transform: scale(1.04); }
  .sonuc-grid__ogr:focus-visible{ outline: 3px solid var(--focus-ring); outline-offset: 3px; }
  .saglik-not{ margin: 12px 0 0; font-size: 12.5px; color: var(--text-muted); }

  /* ---- Nasıl işliyor — numaralı adım listesi --------------------------- */

  .adim-liste{
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    gap: clamp(16px, 2.4vw, 24px);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .adim-liste li{ display: grid; gap: 6px; }
  .adim-liste__no{
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 28px; height: 28px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-baslik);
    font-size: 14px;
  }
  .adim-liste h3{ margin: 4px 0 0; font-size: 16px; }
  .adim-liste p{ margin: 0; font-size: 14px; }

  /* ---- Kapanış CTA ---------------------------------------------------- */

  .saglik-cta{
    text-align: center;
    padding: clamp(28px, 5vw, 44px);
    background: var(--bg-soft);
    border-radius: var(--r-card);
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .saglik-cta h2{ margin-bottom: 0; }
  .saglik-cta .wa-buton{ margin-top: 14px; }

  /* ---- Tam ekran görüntüleyici (Ramses/Tur.astro ile aynı desen) ------ */

  .isik{
    border: 0; padding: 0;
    max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%;
    background: var(--surface-strong);
    color: var(--text-inverse);
  }
  .isik::backdrop{ background: rgba(22,18,43,.92); }
  .isik__cerceve{
    margin: 0; height: 100%;
    display: grid; place-items: center; gap: 12px;
    padding: 48px 16px;
  }
  .isik__cerceve img{
    max-width: min(1200px, 92vw);
    max-height: 78vh;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: var(--r-buton);
  }
  .isik__sayac{ font-size: 13px; color: rgba(247,243,236,.7); font-variant-numeric: tabular-nums; }
  .isik__kapat, .isik__ok{
    position: absolute;
    background: rgba(247,243,236,.1);
    color: var(--kagit);
    border: 0;
    border-radius: var(--r-buton);
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background .2s ease-out;
  }
  .isik__kapat:hover, .isik__ok:hover{ background: rgba(247,243,236,.2); }
  .isik__kapat:focus-visible, .isik__ok:focus-visible{ outline: 3px solid var(--focus-ring); outline-offset: 2px; }
  .isik__kapat{ top: 12px; right: 12px; width: 40px; height: 40px; }
  .isik__ok{ top: 50%; transform: translateY(-50%); width: 44px; height: 56px; }
  .isik__ok--sol{ left: 12px; }
  .isik__ok--sag{ right: 12px; }

  @media (max-width: 520px){
    .tur-hero{ min-height: 380px; }
    .tur-hero__meta span{ font-size: 11px; }
  }

  @media (prefers-reduced-motion: reduce){
    .sonuc-grid__ogr img, .isik__kapat, .isik__ok{ transition: none; }
    .sonuc-grid__ogr:hover img{ transform: none; }
  }
</style>

<script is:inline define:vars={{ fotograflar: tumGaleriGorselleri, altMetin: s.saglik_galeri_alt }}>
  (function () {
    var kaplar = document.querySelectorAll('[data-galeri]');
    var isik = document.querySelector('[data-isik]');
    if (!kaplar.length || !isik || !isik.showModal) return;

    var gorsel = isik.querySelector('[data-isik-gorsel]');
    var sayac = isik.querySelector('[data-isik-sayac]');
    var indeks = 0;

    function goster(i) {
      indeks = (i + fotograflar.length) % fotograflar.length;
      gorsel.src = fotograflar[indeks];
      gorsel.alt = altMetin;
      if (sayac) sayac.textContent = (indeks + 1) + ' / ' + fotograflar.length;
    }

    kaplar.forEach(function (kap) {
      kap.addEventListener('click', function (e) {
        var dugme = e.target.closest('[data-galeri-ac]');
        if (!dugme) return;
        goster(parseInt(dugme.getAttribute('data-galeri-ac'), 10) || 0);
        isik.showModal();
      });
    });

    isik.addEventListener('click', function (e) {
      var yon = e.target.closest('[data-isik-yon]');
      if (yon) { goster(indeks + parseInt(yon.getAttribute('data-isik-yon'), 10)); return; }
      if (e.target.closest('[data-isik-kapat]')) { isik.close(); return; }
      if (!e.target.closest('.isik__cerceve img')) isik.close();
    });

    isik.addEventListener('keydown', function (e) {
      if (fotograflar.length < 2) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); goster(indeks + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goster(indeks - 1); }
    });
  })();
</script>
