---
import type { Dil } from '../lib/tipler';
import TemelSayfa from '../layouts/TemelSayfa.astro';
import TurKart from '../components/TurKart.astro';
import RamsesTanitimKart from '../components/RamsesTanitimKart.astro';
import HavaDurumu from '../components/HavaDurumu.astro';
import MesafeHaritasi from '../components/MesafeHaritasi.astro';
import WaIkon from '../components/WaIkon.astro';
import { MARKA, SLOGAN, WA_NUMBERS } from '../config/marka';
import { sozluk, yerlestir } from '../i18n/sozluk';
import { KATEGORILER, BOLGELER } from '../data/taksonomi';
import { TRANSFER_DOGU, TRANSFER_BATI } from '../data/transferler';
import { euroTutar } from '../lib/fiyat';
import {
  listelenebilirTurlar, kategorininTurlari, bolgeninTurlari,
  kategoriUrl, bolgeUrl, turlarUrl, planUrl, rehberUrl, transferUrl,
} from '../lib/rotalar';

interface Props {
  dil: Dil;
  alternatifler: Record<Dil, string>;
}

const { dil, alternatifler: alt } = Astro.props;
const s = sozluk[dil];

// Ana sayfa merchandising: one_cikan adaylarını önce, ardından kalan tüm aktif
// turları sabit sırayla ekler — ana sayfada tüm aktif turlar listelenir (3 ile sınırlı değil).
const listelenebilir = listelenebilirTurlar();
const oneCikanAdaylari = listelenebilir.filter((t) => t.one_cikan);
const oneCikanTamamlayiciSirasi = [
  'aksu-dolphin-experience',
  'jeep-kaiser',
  'jeep-kaiser-night-safari',
  'peloid-hamam-spa',
];
const oneCikanlar = [
  ...oneCikanAdaylari,
  ...oneCikanTamamlayiciSirasi
    .map((id) => listelenebilir.find((t) => t.id === id))
    .filter((t): t is (typeof listelenebilir)[number] => !!t && !oneCikanAdaylari.some((o) => o.id === t.id)),
];

const baslik = `${MARKA} · ${s.meta_ana_baslik}`;

// Transfer öncelik kartı — en düşük bölge fiyatı "…€'dan başlayan" rozetinde,
// tek yön WhatsApp mesajı TurKart.astro'daki kalıpla aynı (build zamanında hazır).
const transferEnDusukFiyat = Math.min(...TRANSFER_DOGU.map((b) => b.fiyat_eur), ...TRANSFER_BATI.map((b) => b.fiyat_eur));
const transferWaMesaj = `${s.m_selamlama}\n\n${s.m_tur}: ${s.transfer_ana_teaser_baslik}\n\n${s.m_kapanis}`;
const transferWaLink = `https://wa.me/${WA_NUMBERS[dil]}?text=${encodeURIComponent(transferWaMesaj)}`;
---
<TemelSayfa dil={dil} baslik={baslik} aciklama={s.meta_ana_aciklama} alternatifler={alt}>
  <!-- 1. Hero: tek fotoğraf, video yok (alan hazır, boş — §4.5) -->
  <section class="hero hero--v2">
    <picture>
      <source media="(max-width: 767px)" srcset="/hero-antalya-sunset-mobil.webp" width="1080" height="1350" />
      <img
        class="hero__gorsel"
        src="/hero-antalya-sunset-2400.webp"
        alt=""
        width="2400"
        height="1350"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__icerik">
      <p class="hero__eyebrow">{MARKA} · {s.nav_turlar}</p>
      <p class="hero__slogan">{SLOGAN[dil]}</p>
      <h1>{s.hero_h1}</h1>
      <p class="hero__alt">{s.hero_alt}</p>
      <div class="hero__aksiyonlar">
        <a class="buton-govde buton-govde--acik" href={turlarUrl(dil)}>{s.nav_turlar}</a>
        <a class="buton-sade buton-sade--hero" href={planUrl(dil)}>{s.plan_nav}</a>
      </div>
      <form class="hero__arama" action={turlarUrl(dil)} method="get" role="search">
        <input type="search" name="q" placeholder={s.hero_arama} aria-label={s.hero_arama} />
        <button type="submit">{s.hero_arama_buton}</button>
      </form>
      <ul class="hero__guvence" aria-label={s.hero_alt}>
        <li>{s.rozet_odeme}</li>
        <li>{s.rozet_transfer}</li>
        <li>{s.rozet_iptal}</li>
      </ul>
    </div>
  </section>

  <!-- Havalimanı transferi — Öne çıkan hizmetler'in üstünde, en yüksek vurguda
       (kullanıcı isteği: yarınki görüşmede Transferler öne çıkarılacak). -->
  <section class="kap bolum--dar ana-bolum ana-bolum--transfer">
    <div class="transfer-oncelik">
      <a
        class="transfer-oncelik__stretch"
        href={transferUrl(dil)}
        aria-hidden="true"
        tabindex="-1"
      ></a>
      <img
        class="transfer-oncelik__gorsel"
        src="/gorseller/havalimani-transferi/havalimani-transferi-07-galeri.webp"
        alt=""
        width="1600" height="1200"
        loading="eager" decoding="async"
      />
      <span class="transfer-oncelik__golge" aria-hidden="true"></span>
      <div class="transfer-oncelik__icerik">
        <span class="transfer-oncelik__rozet">{s.transfer_eyebrow}</span>
        <h2>{s.transfer_ana_teaser_baslik}</h2>
        <p>{s.transfer_ana_teaser_metin}</p>
        <div class="transfer-oncelik__fiyat">{yerlestir(s.fiyat_baslayan, { f: euroTutar(transferEnDusukFiyat, dil) })}</div>
        <div class="transfer-oncelik__aksiyonlar">
          <a class="buton-govde" href={transferUrl(dil)}>{s.transfer_ana_teaser_buton}</a>
          <a class="wa-buton" href={transferWaLink} target="_blank" rel="noopener">
            <WaIkon boyut={16} />
            {s.transfer_cta_wa}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Öne çıkan hizmetler — turlar + Ramses Ink (gerçek bir tur değil, en sonda) -->
  <section class="kap bolum ana-bolum ana-bolum--one">
    <div class="bolum-baslik">
      <div class="bolum-baslik__grup">
        <p class="bolum-baslik__eyebrow">{s.b_one_cikan_eyebrow}</p>
        <h2>{s.b_one_cikan}</h2>
      </div>
      <a class="metin-link" href={turlarUrl(dil)}>{s.tum_hizmetler}</a>
    </div>
    <div class="grid">
      {oneCikanlar.map((t, i) => <TurKart dil={dil} tur={t} oncelikli={i < 3} />)}
      <RamsesTanitimKart dil={dil} />
    </div>
  </section>

  <!-- Mesafe haritası — öne çıkan turların altında (EK-1 §3) -->
  <MesafeHaritasi lang={dil} />

  <!-- 4. Kategoriler — 6 kart -->
  <section class="bolum ana-bant">
    <div class="kap">
    <div class="bolum-baslik">
      <h2>{s.b_kategoriler}</h2>
    </div>
    <div class="grid">
      {KATEGORILER.map((k) => (
        <a class="kat-kart" href={kategoriUrl(dil, k)}>
          <h3>{k.ad[dil]}</h3>
          <span>({kategorininTurlari(k.kod).length})</span>
        </a>
      ))}
    </div>
    </div>
  </section>

  <!-- 5. Neden biz — 5 madde (§9) -->
  <section class="kap bolum ana-bolum ana-bolum--trust">
    <div class="bolum-baslik">
      <h2>{s.b_neden}</h2>
    </div>
    <div class="neden">
      {s.neden.map((n) => (
        <article>
          <h3>{n.baslik}</h3>
          <p>{n.metin}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Hava durumu — Neden biz'in altında (EK-1 §2) -->
  <HavaDurumu dil={dil} />

  <!-- Tatil planlayıcı çağrısı (EK-1 §4) — JS yok, /plan/ sayfasına götürür -->
  <section class="kap bolum--dar ana-bolum">
    <div class="plan-cagri">
      <div>
        <h2>{s.plan_baslik}</h2>
        <p class="ikincil">{s.plan_ozet}</p>
      </div>
      <a class="buton-govde" href={planUrl(dil)}>{s.plan_nav}</a>
    </div>
  </section>

  <!-- 6. Nereden kalkıyorsunuz? — 8 bölge, metin bağlantı listesi -->
  <section class="kap bolum ana-bolum ana-bolum--bolgeler">
    <div class="bolum-baslik">
      <h2>{s.b_bolgeler}</h2>
    </div>
    <ul class="bolge-liste">
      {BOLGELER.map((b) => (
        <li>
          <a href={bolgeUrl(dil, b)}>{b.ad[dil]}</a>
          <span class="ikincil"> ({bolgeninTurlari(b.kod).length})</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Antalya rehberi bloğu (EK-1 menü). Faz 1'de 2 kart;
       aylık rehber ve hazır planlar yayınlanınca 4'e çıkar. -->
  <section class="kap bolum ana-bolum">
    <div class="bolum-baslik">
      <h2>{s.rehber_grup}</h2>
    </div>
    <div class="grid">
      <a class="kat-kart" href={rehberUrl(dil, 'pratik')}>
        <h3>{s.rehber_pratik_baslik}</h3>
      </a>
      <a class="kat-kart" href={rehberUrl(dil, 'ucretsiz')}>
        <h3>{s.rehber_ucretsiz_baslik}</h3>
      </a>
    </div>
  </section>
</TemelSayfa>

<style>
  /* ---- "Öne çıkan hizmetler" başlığı: eyebrow + büyütülmüş serif -----
     Ana sayfadaki diğer bölüm başlıklarından bilinçli olarak daha
     dikkat çekici (kullanıcı isteği — bu bölüm en üstte, en görünür). */
  .bolum-baslik__grup{ display: flex; flex-direction: column; gap: 6px; }
  .bolum-baslik__eyebrow{
    margin: 0;
    color: var(--accent-hover);
    font-family: var(--font-govde);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .ana-bolum--one .bolum-baslik h2{ font-size: clamp(32px, 4.2vw, 48px); }

  /* ---- Transfer öncelik kartı ----------------------------------------
     Tur.astro'daki .tur-hero deseniyle aynı dil: tam kare görsel +
     karanlık degrade + üzerine metin. Ana sayfada bu üsluba sahip tek
     bölüm olduğu için kendiliğinden öne çıkar (kullanıcı isteği). */
  .transfer-oncelik{
    position: relative;
    display: block;
    min-height: clamp(360px, 48vw, 520px);
    border-radius: var(--r-kart);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow: var(--shadow-lg);
    transition: box-shadow .3s ease-out;
  }
  /* Tüm kart tıklanabilir: görünmez, tam kaplayan bağlantı (foto dahil her
     yere tıklamak Transfer sayfasını açar). Erişilebilir isim gerekmez —
     alttaki "Transfer Fiyatlarını Gör" butonu klavye/ekran okuyucu için
     zaten gerçek, odaklanabilir bağlantı; bu katman yalnızca fare/dokunma
     kolaylığı (kullanıcı isteği). */
  .transfer-oncelik__stretch{
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }
  .transfer-oncelik__gorsel{
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(.94) contrast(1.05);
    transition: transform .4s ease-out;
  }
  .transfer-oncelik:hover .transfer-oncelik__gorsel,
  .transfer-oncelik:focus-within .transfer-oncelik__gorsel{
    transform: scale(1.035);
  }
  .transfer-oncelik:hover,
  .transfer-oncelik:focus-within{
    box-shadow: 0 32px 80px rgba(22,18,43,.24);
  }
  .transfer-oncelik__golge{
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(22,18,43,.14) 0%, rgba(22,18,43,.42) 48%, rgba(22,18,43,.86) 100%),
      linear-gradient(90deg, rgba(22,18,43,.46) 0%, rgba(22,18,43,.02) 58%);
    pointer-events: none;
  }
  .transfer-oncelik__icerik{
    position: absolute;
    z-index: 2;
    left: clamp(20px, 4vw, 44px);
    right: clamp(20px, 4vw, 44px);
    bottom: clamp(22px, 4vw, 44px);
    display: grid;
    gap: 10px;
    max-width: 640px;
    pointer-events: none;
  }
  .transfer-oncelik__rozet{
    width: max-content;
    border: 1px solid rgba(247,243,236,.42);
    border-radius: var(--r-rozet);
    padding: 7px 12px;
    color: var(--text-inverse);
    background: rgba(22,18,43,.36);
    font-size: 12px;
    letter-spacing: .02em;
  }
  .transfer-oncelik__icerik h2{
    margin: 0;
    color: var(--beyaz);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.04;
  }
  .transfer-oncelik__icerik p{
    margin: 0;
    max-width: 520px;
    color: rgba(247,243,236,.88);
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.5;
  }
  .transfer-oncelik__fiyat{
    font-family: var(--font-baslik);
    font-weight: 500;
    font-size: clamp(17px, 1.8vw, 20px);
    color: var(--pirinc);
  }
  .transfer-oncelik__aksiyonlar{
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
    /* İçerik katmanı (üstteki .icerik) tıklamayı yayılan bağlantıya bırakır
       (pointer-events:none); gerçek butonlar burada tekrar etkinleştirilir. */
    pointer-events: auto;
  }

  @media (max-width: 520px){
    .transfer-oncelik{ min-height: 440px; }
    .transfer-oncelik__aksiyonlar{ flex-direction: column; align-items: stretch; }
    .transfer-oncelik__aksiyonlar .buton-govde,
    .transfer-oncelik__aksiyonlar .wa-buton{ justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce){
    .transfer-oncelik,
    .transfer-oncelik__gorsel{ transition: none; }
    .transfer-oncelik:hover .transfer-oncelik__gorsel,
    .transfer-oncelik:focus-within .transfer-oncelik__gorsel{ transform: none; }
  }
</style>
