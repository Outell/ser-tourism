---
import type { Dil } from '../lib/tipler';
import { MARKA, SLOGAN, SOCIAL_LINKS, WA_NUMBERS } from '../config/marka';
import { anaUrl, metinUrl, turlarUrl, kategoriUrl, rehberUrl, planUrl } from '../lib/rotalar';
import { KATEGORILER } from '../data/taksonomi';
import { sozluk } from '../i18n/sozluk';
import WaIkon from './WaIkon.astro';
import SerLogo from './SerLogo.astro';

interface Props { dil: Dil }

// Footer — EK-1 menü güncellemesi: üç grup (Turlar · Antalya rehberi · Biz).
// Aylık rehber ve hazır planlar Faz 2'de yayınlanınca rehber grubuna eklenecek —
// yayında olmayan sayfaya bağlantı verilmez ("boş alan sessizdir").
const { dil } = Astro.props;
const s = sozluk[dil];
const yil = new Date().getFullYear();
const waLink = `https://wa.me/${WA_NUMBERS[dil]}`;
---
<footer class="altbilgi">
  <div class="kap altbilgi__ic">
    <div class="altbilgi__marka">
      <a class="marka marka--footer" href={anaUrl(dil)} aria-label={MARKA}>
        <SerLogo variant="full" decorative />
      </a>
      <p class="altbilgi__slogan">{SLOGAN[dil]}</p>
      <div class="altbilgi__sosyal social-row" role="group" aria-label={s.s_iletisim}>
        {SOCIAL_LINKS.instagram && (
          <a class="social-icon social-icon--instagram" href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label={s.instagram_etiket}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="16" height="16" rx="4" />
              <circle cx="12" cy="12" r="3.5" />
              <path d="M17.3 6.8h.01" />
            </svg>
          </a>
        )}
        <a class="social-icon social-icon--wa" href={waLink} target="_blank" rel="noopener" aria-label={s.whatsapp_etiket}>
          <WaIkon boyut={18} />
        </a>
      </div>
    </div>

    <div>
      <h2 class="altbilgi__grup">{s.nav_turlar}</h2>
      <ul>
        <li><a href={turlarUrl(dil)}>{s.tum_turlar}</a></li>
        {KATEGORILER.map((k) => (
          <li><a href={kategoriUrl(dil, k)}>{k.ad[dil]}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="altbilgi__grup">{s.rehber_grup}</h2>
      <ul>
        <li><a href={rehberUrl(dil, 'pratik')}>{s.rehber_pratik_baslik}</a></li>
        <li><a href={rehberUrl(dil, 'ucretsiz')}>{s.rehber_ucretsiz_baslik}</a></li>
        <li><a href={planUrl(dil)}>{s.plan_nav}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="altbilgi__grup">{s.s_biz}</h2>
      <ul>
        <li><a href={metinUrl(dil, 'hakkimizda')}>{s.s_hakkimizda}</a></li>
        <li><a href={metinUrl(dil, 'iletisim')}>{s.s_iletisim}</a></li>
        <li><a href={metinUrl(dil, 'iptal')}>{s.s_iptal}</a></li>
        <li><a href={metinUrl(dil, 'sss')}>{s.s_sss}</a></li>
        <li><a href={metinUrl(dil, 'gizlilik')}>{s.s_gizlilik}</a></li>
      </ul>
    </div>
  </div>
  <div class="kap altbilgi__alt">© {yil} {MARKA}</div>
</footer>
