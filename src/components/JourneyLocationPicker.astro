---
import type { Dil } from '../lib/tipler';
import { sozluk } from '../i18n/sozluk';
import {
  getJourneyPickupZones,
  SELECTED_LOCATION_STORAGE_KEY,
  LOCATION_DISMISSED_SESSION_KEY,
} from '../lib/journey';

interface Props {
  dil: Dil;
  tourId?: string;
}

const { dil, tourId = 'adventure-combo' } = Astro.props;
const s = sozluk[dil];
const zones = getJourneyPickupZones(tourId);
const zoneLabels = zones.map((zone) => ({ code: zone.code, label: zone.label[dil] }));
---

{zones.length > 0 && (
  <section class="journey-location kap" data-journey-location-picker>
    <div class="journey-location__metin">
      <p class="journey-location__eyebrow">Interactive Journey</p>
      <h2>{s.journey.locationBaslik}</h2>
      <p>{s.journey.locationAlt}</p>
      <p class="journey-location__durum" data-location-saved hidden aria-live="polite"></p>
    </div>

    <form class="journey-location__form" data-location-form>
      <label for={`journey-location-${tourId}`}>{s.journey.locationLabel}</label>
      <div class="journey-location__kontrol">
        <select id={`journey-location-${tourId}`} data-location-select>
          <option value="">{s.journey.locationPlaceholder}</option>
          {zoneLabels.map((zone) => <option value={zone.code}>{zone.label}</option>)}
        </select>
        <button type="submit">{s.journey.locationSave}</button>
      </div>
      <button class="journey-location__ikincil" type="button" data-location-later>
        {s.journey.locationLater}
      </button>
    </form>

    <div class="journey-location__kayitli" data-location-current hidden>
      <p data-location-current-text></p>
      <button type="button" data-location-change>{s.journey.locationChange}</button>
    </div>
  </section>
)}

<style>
  .journey-location{
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    gap: 22px;
    align-items: end;
    margin-block: clamp(34px, 5vw, 62px) clamp(8px, 2vw, 18px);
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--border);
    border-radius: var(--r-kart);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface-elevated) 94%, transparent), color-mix(in srgb, var(--bg-soft) 72%, transparent));
    box-shadow: 0 18px 48px rgba(20, 18, 36, .08);
  }
  .journey-location[hidden]{ display: none !important; }
  .journey-location__metin{
    display: grid;
    gap: 8px;
  }
  .journey-location__eyebrow{
    margin: 0;
    color: var(--action);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .journey-location h2{
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-baslik);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 500;
    line-height: 1.04;
  }
  .journey-location p{
    margin: 0;
    max-width: 660px;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .journey-location__durum{
    color: var(--action) !important;
    font-weight: 600;
  }
  .journey-location__form,
  .journey-location__kayitli{
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .journey-location__form[hidden],
  .journey-location__kayitli[hidden],
  .journey-location__durum[hidden]{ display: none !important; }
  .journey-location label{
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
  }
  .journey-location__kontrol{
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .journey-location select,
  .journey-location button{
    min-height: 44px;
    border-radius: var(--r-buton);
    font: inherit;
  }
  .journey-location select{
    width: 100%;
    min-width: 0;
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    color: var(--text-primary);
    padding: 0 12px;
  }
  .journey-location button{
    border: 1px solid var(--border);
    background: var(--surface-strong);
    color: var(--text-inverse);
    padding: 0 16px;
    font-weight: 700;
    cursor: pointer;
    transition: border-color .18s ease-out, background .18s ease-out, color .18s ease-out;
  }
  .journey-location button:hover{
    border-color: var(--action);
    color: var(--action-hover);
  }
  .journey-location__ikincil{
    width: max-content;
    min-height: 34px !important;
    padding-inline: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: var(--text-muted) !important;
    font-size: 13px !important;
  }
  .journey-location__ikincil:hover{ color: var(--action) !important; }
  .journey-location__kayitli{
    align-self: center;
    justify-items: start;
  }
  .journey-location__kayitli p{
    color: var(--text-primary);
    font-weight: 700;
  }
  .journey-location__kayitli button{
    min-height: 36px;
    background: transparent;
    color: var(--text-primary);
  }

  @media (max-width: 760px){
    .journey-location{
      grid-template-columns: 1fr;
      margin-block: 30px 10px;
      padding: 18px;
    }
    .journey-location__kontrol{
      grid-template-columns: 1fr;
    }
    .journey-location button{
      width: 100%;
    }
    .journey-location__ikincil{
      width: auto;
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .journey-location button{ transition: none; }
  }
</style>

<script is:inline define:vars={{
  zones: zoneLabels,
  selectedLocationKey: SELECTED_LOCATION_STORAGE_KEY,
  dismissedKey: LOCATION_DISMISSED_SESSION_KEY,
  currentTemplate: s.journey.locationCurrent,
  savedText: s.journey.locationSaved,
}}>
  (function () {
    var root = document.querySelector('[data-journey-location-picker]');
    if (!root) return;

    var form = root.querySelector('[data-location-form]');
    var select = root.querySelector('[data-location-select]');
    var later = root.querySelector('[data-location-later]');
    var current = root.querySelector('[data-location-current]');
    var currentText = root.querySelector('[data-location-current-text]');
    var saved = root.querySelector('[data-location-saved]');
    var change = root.querySelector('[data-location-change]');
    var labels = {};

    zones.forEach(function (zone) {
      labels[zone.code] = zone.label;
    });

    function readSelection() {
      try {
        var raw = window.localStorage.getItem(selectedLocationKey);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || parsed.type !== 'pickup-zone' || !labels[parsed.code]) return null;
        return parsed.code;
      } catch (error) {
        return null;
      }
    }

    function writeSelection(code) {
      try {
        window.localStorage.setItem(selectedLocationKey, JSON.stringify({ type: 'pickup-zone', code: code }));
        try { window.sessionStorage.removeItem(dismissedKey); } catch (error) {}
        return true;
      } catch (error) {
        return false;
      }
    }

    function wasDismissed() {
      try { return window.sessionStorage.getItem(dismissedKey) === '1'; }
      catch (error) { return false; }
    }

    function setDismissed() {
      try { window.sessionStorage.setItem(dismissedKey, '1'); } catch (error) {}
    }

    function render() {
      var code = readSelection();
      if (code) {
        root.hidden = false;
        form.hidden = true;
        current.hidden = false;
        saved.hidden = true;
        if (select) select.value = code;
        currentText.textContent = currentTemplate.replace('{location}', labels[code]);
        return;
      }

      if (wasDismissed()) {
        root.hidden = true;
        return;
      }

      root.hidden = false;
      form.hidden = false;
      current.hidden = true;
      saved.hidden = true;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var code = select.value;
      if (!labels[code]) return;
      if (!writeSelection(code)) return;
      window.dispatchEvent(new CustomEvent('limyra:journey-location-change', {
        detail: { type: 'pickup-zone', code: code, label: labels[code] }
      }));
      render();
      saved.textContent = savedText;
      saved.hidden = false;
    });

    later.addEventListener('click', function () {
      setDismissed();
      root.hidden = true;
    });

    change.addEventListener('click', function () {
      root.hidden = false;
      form.hidden = false;
      current.hidden = true;
      saved.hidden = true;
      if (select) select.focus();
    });

    render();
  })();
</script>
