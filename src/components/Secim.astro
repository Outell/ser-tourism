---
// Açılır menü sarmalayıcısı (EK-4 §2) — sistem okunu kaldırıp
// kendi chevron'umuzu koyar. Ok, menü açıkken 180° döner.
// Kullanım: <Secim><select>…</select></Secim>
interface Props {
  sinif?: string;   // 'secim--dar' | 'secim--acik' (koyu zeminde beyaz ok)
}
const { sinif = '' } = Astro.props;
---
<span class:list={['secim', sinif]}>
  <slot />
  <svg class="secim__ok" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
       fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 6.5 8 10.5 12 6.5" />
  </svg>
</span>
