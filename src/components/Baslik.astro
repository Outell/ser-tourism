---
import type { Dil } from '../lib/tipler';
import { DILLER } from '../lib/tipler';
import { MARKA, SOCIAL_LINKS, WA_NUMBERS } from '../config/marka';
import { anaUrl, turlarUrl, transferUrl, planUrl, saglikUrl } from '../lib/rotalar';
import { sozluk, DIL_ADLARI, DIL_BAYRAKLARI, PARA_SIMGELERI } from '../i18n/sozluk';
import HavaRozeti from './HavaRozeti.astro';
import Secim from './Secim.astro';
import WaIkon from './WaIkon.astro';
import SerLogo from './SerLogo.astro';

interface Props {
  dil: Dil;
  alternatifler: Record<Dil, string>;
}

// Menü yalnızca: Turlar · dil seçici · döviz seçici (MASTER-PROMPT §5.5).
// Güven sayfaları footer'da. Dil değiştirici AYNI sayfanın çevirisine gider (§6.4).
const { dil, alternatifler: alt } = Astro.props;
const s = sozluk[dil];
const paralar = Object.keys(PARA_SIMGELERI);
const waLink = `https://wa.me/${WA_NUMBERS[dil]}`;
---
<header class="ustbar">
  <div class="kap ustbar__ic">
    <a class="marka" href={anaUrl(dil)} aria-label={MARKA}>
      <SerLogo variant="full" decorative />
    </a>

    <!-- Menü (EK-1): Turlar · Plan yap · dil · döviz -->
    <nav class="ustbar__nav" aria-label={s.nav_turlar}>
      <a class="ustbar__link" href={turlarUrl(dil)}>{s.nav_turlar}</a>
      <a class="ustbar__link" href={transferUrl(dil)}>{s.nav_transfer}</a>
      <a class="ustbar__link" href={saglikUrl(dil)}>{s.saglik_baslik}</a>
      <a class="ustbar__link" href={planUrl(dil)}>{s.plan_nav}</a>

      {/* Dil seçici — mobilde top-bar'da hamburger'in yanında kalır, EK-2 §B */}
      <details class="dil-sec">
        <summary aria-label={s.dil_secici_etiket}>
          <span aria-hidden="true">{DIL_BAYRAKLARI[dil]}</span> {dil.toUpperCase()}
        </summary>
        <ul class="dil-sec__liste">
          {DILLER.map((d) => (
            <li>
              <a
                href={alt[d]}
                lang={d}
                aria-label={DIL_ADLARI[d]}
                aria-current={d === dil ? 'true' : undefined}
              >
                <span aria-hidden="true">{DIL_BAYRAKLARI[d]}</span> {DIL_ADLARI[d]}
              </a>
            </li>
          ))}
        </ul>
      </details>

      {/* Hava rozeti — mobilde de top-bar'da, hamburger'in bir yanında (EK-2 §B) */}
      <HavaRozeti dil={dil} />

      <Secim sinif="secim--dar secim--acik">
        <select class="para-sec" data-para-sec aria-label={s.para_secici_etiket}>
          {paralar.map((p) => <option value={p}>{PARA_SIMGELERI[p]}</option>)}
        </select>
      </Secim>

      <button class="tema-toggle" type="button" data-tema-toggle aria-label={s.tema_degistir}>
        <svg class="tema-toggle__gunes" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="tema-toggle__ay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M20 14.5A7.5 7.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
        </svg>
      </button>

    </nav>

    <button class="menu-btn" type="button" data-menu-ac aria-label={s.menu_ac} aria-controls="mobil-menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

  <div class="mobil-menu" id="mobil-menu" data-mobil-menu hidden>
    <div class="mobil-menu__panel" role="dialog" aria-modal="true" aria-label={s.nav_turlar}>
      <div class="mobil-menu__ust">
        <a class="marka" href={anaUrl(dil)} aria-label={MARKA}>
          <SerLogo variant="compact" decorative />
        </a>
        <button class="menu-btn menu-btn--kapat" type="button" data-menu-kapat aria-label={s.menu_kapat}>
          <span></span><span></span>
        </button>
      </div>

      <nav class="mobil-menu__nav" aria-label={s.nav_turlar}>
        <a href={turlarUrl(dil)}>{s.nav_turlar}</a>
        <a href={transferUrl(dil)}>{s.nav_transfer}</a>
        <a href={saglikUrl(dil)}>{s.saglik_baslik}</a>
        <a href={planUrl(dil)}>{s.plan_nav}</a>
      </nav>

      <div class="mobil-menu__araclar">
        <button class="tema-toggle tema-toggle--mobil" type="button" data-tema-toggle aria-label={s.tema_degistir}>
          <svg class="tema-toggle__gunes" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="tema-toggle__ay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20 14.5A7.5 7.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
          </svg>
          <span>{s.tema_degistir}</span>
        </button>

        <Secim sinif="secim--dar">
          <select class="para-sec para-sec--mobil" data-para-sec aria-label={s.para_secici_etiket}>
            {paralar.map((p) => <option value={p}>{PARA_SIMGELERI[p]}</option>)}
          </select>
        </Secim>
      </div>

      <div class="mobil-menu__social social-row" role="group" aria-label={s.s_iletisim}>
        {SOCIAL_LINKS.instagram && (
          <a class="social-icon social-icon--instagram" href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label={s.instagram_etiket}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="16" height="16" rx="4" />
              <circle cx="12" cy="12" r="3.5" />
              <path d="M17.3 6.8h.01" />
            </svg>
          </a>
        )}
        <a class="social-icon social-icon--wa" href={waLink} target="_blank" rel="noopener" aria-label={s.whatsapp_etiket}>
          <WaIkon boyut={18} />
        </a>
      </div>
    </div>
  </div>

<script is:inline>
  document.addEventListener('click', function (e) {
    document.querySelectorAll('.dil-sec[open]').forEach(function (d) {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });

  (function () {
    var kok = document.documentElement;
    var menu = document.querySelector('[data-mobil-menu]');
    var ac = document.querySelector('[data-menu-ac]');
    var kapat = document.querySelector('[data-menu-kapat]');
    var oncekiOdak = null;

    function temaYaz(tema) {
      kok.dataset.theme = tema;
      kok.style.colorScheme = tema;
      try { localStorage.setItem('limyra-theme', tema); } catch (e) {}
      window.dispatchEvent(new CustomEvent('limyra-theme-change'));
    }

    document.querySelectorAll('[data-tema-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        temaYaz(kok.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    });

    function menuAc() {
      if (!menu || !ac) return;
      oncekiOdak = document.activeElement;
      menu.hidden = false;
      requestAnimationFrame(function () { menu.classList.add('mobil-menu--acik'); });
      ac.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-acik');
      var ilk = menu.querySelector('a, button, select, summary');
      if (ilk) ilk.focus();
    }

    function menuKapat() {
      if (!menu || !ac) return;
      menu.classList.remove('mobil-menu--acik');
      ac.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-acik');
      window.setTimeout(function () { menu.hidden = true; }, 180);
      if (oncekiOdak && oncekiOdak.focus) oncekiOdak.focus();
    }

    if (ac) ac.addEventListener('click', menuAc);
    if (kapat) kapat.addEventListener('click', menuKapat);
    if (menu) {
      menu.addEventListener('click', function (e) { if (e.target === menu) menuKapat(); });
      menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', menuKapat); });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu && !menu.hidden) menuKapat();
    });
  })();
</script>
