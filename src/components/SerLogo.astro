---
type LogoVariant = 'full' | 'compact' | 'monogram';

interface Props {
  variant?: LogoVariant;
  label?: string;
  decorative?: boolean;
  class?: string;
}

const {
  variant = 'full',
  label = 'SER Tourism & Travel',
  decorative = false,
  class: className = '',
} = Astro.props;

const rootClass = ['ser-logo', `ser-logo--${variant}`, className].filter(Boolean).join(' ');
const ariaProps = decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label };
---

{variant === 'monogram' ? (
  <svg class={rootClass} viewBox="0 0 64 64" fill="none" {...ariaProps}>
    <circle class="ser-logo__ring" cx="32" cy="32" r="25.5" pathLength="100" />
    <path class="ser-logo__ring-gap" d="M49.9 13.9a25.5 25.5 0 0 1 5.7 11.9" pathLength="100" />
    <path class="ser-logo__accent" d="M49.2 13.8 55.8 12.3 54.2 18.8" />
    <text class="ser-logo__ser ser-logo__ser--mono" x="32" y="42" text-anchor="middle">S</text>
  </svg>
) : (
  <img
    class={rootClass}
    src="/ser-logo.png"
    width="730"
    height="296"
    decoding="async"
    {...(decorative ? { alt: '' } : { alt: label })}
  />
)}
