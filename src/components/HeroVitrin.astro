---
// src/components/HeroVitrin.astro
//
// Hero bölümünün öne çıkardığı 3 tur (+ genel bir "tüm turlar" slaydı) için
// 5 saniyede bir otomatik değişen, tekli fotoğraf kartı. Masaüstünde hero
// görselinin sağ-alt köşesinde yüzer; mobil/tablette hero içeriğinin altında
// normal akışta durur (kullanıcı isteği: her cihazda görünsün).
//
// Sıra: genel tanıtım → Adventure Combo → Aksu Dolphin Experience → Jeep Kaizer.

import type { Dil } from '../lib/tipler';
import { sozluk, yerlestir } from '../i18n/sozluk';
import { turBul, turUrl, turlarUrl } from '../lib/rotalar';

interface Props { dil: Dil; }
const { dil } = Astro.props;
const s = sozluk[dil];

const ONE_CIKAN_TUR_ID = ['adventure-combo', 'aksu-dolphin-experience', 'jeep-kaiser'] as const;

const turSlaytlari = ONE_CIKAN_TUR_ID
  .map((id) => turBul(id))
  .filter((t): t is NonNullable<typeof t> => !!t)
  .map((t) => ({
    baslik: t.baslik[dil],
    aciklama: t.ozet[dil],
    gorsel: t.kapak,
    altMetin: t.alt_metin?.[dil] ?? t.baslik[dil],
    href: turUrl(dil, t),
    buton: s.vitrin_rezervasyon_buton,
  }));

const slaytlar = [
  {
    baslik: s.hero_h1,
    aciklama: s.vitrin_genel_aciklama,
    gorsel: '/hero-antalya-sunset-2400.webp',
    altMetin: '',
    href: turlarUrl(dil),
    buton: s.vitrin_kesfet_buton,
  },
  ...turSlaytlari,
];
---

<div class="hero-vitrin" data-hero-vitrin aria-roledescription="carousel" aria-label={s.vitrin_bolum_etiket}>
  <div class="hero-vitrin__kart">
    {slaytlar.map((sl, i) => (
      <article
        class="hero-vitrin__slayt"
        data-vitrin-slayt
        aria-hidden={i === 0 ? 'false' : 'true'}
        inert={i === 0 ? undefined : true}
      >
        {sl.gorsel && (
          <img
            class="hero-vitrin__gorsel"
            src={sl.gorsel}
            alt={sl.altMetin}
            width="1200"
            height="900"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        )}
        <span class="hero-vitrin__golge" aria-hidden="true"></span>
        <div class="hero-vitrin__icerik">
          <h3 class="hero-vitrin__baslik">{sl.baslik}</h3>
          <p class="hero-vitrin__aciklama">{sl.aciklama}</p>
          <a class="buton-govde hero-vitrin__buton" href={sl.href}>{sl.buton}</a>
        </div>
      </article>
    ))}
  </div>

  <div class="hero-vitrin__cizgiler" role="tablist" aria-label={s.vitrin_bolum_etiket}>
    {slaytlar.map((_, i) => (
      <button
        type="button"
        class="hero-vitrin__cizgi"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        data-vitrin-git={i}
        aria-label={yerlestir(s.vitrin_slayt_git, { n: i + 1 })}
      >
        <span class="hero-vitrin__cizgi-dolgu"></span>
      </button>
    ))}
  </div>
</div>

<style>
  .hero-vitrin{
    position: relative;
    z-index: 2;
    width: min(100%, 360px);
    margin-top: 28px;
    animation: heroMetinGir .58s cubic-bezier(.16, 1, .3, 1) both .5s;
  }

  .hero-vitrin__kart{
    position: relative;
    height: clamp(300px, 34vw, 360px);
    border-radius: var(--r-kart);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow: var(--shadow-lg);
  }

  .hero-vitrin__slayt{
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity .5s ease-out;
    pointer-events: none;
  }
  .hero-vitrin__slayt[aria-hidden="false"]{
    opacity: 1;
    pointer-events: auto;
  }

  .hero-vitrin__gorsel{
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }

  .hero-vitrin__golge{
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8,11,22,.92) 0%, rgba(8,11,22,.52) 46%, rgba(8,11,22,.06) 78%);
    pointer-events: none;
  }

  .hero-vitrin__icerik{
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: grid;
    gap: 6px;
    padding: 18px 20px 20px;
  }

  .hero-vitrin__baslik{
    margin: 0;
    color: var(--beyaz);
    font-family: var(--font-baslik);
    font-size: clamp(19px, 2.1vw, 23px);
    line-height: 1.12;
  }

  .hero-vitrin__aciklama{
    margin: 0 0 10px;
    max-width: 46ch;
    color: rgba(247,243,236,.86);
    font-size: 13.5px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-vitrin__buton{
    width: max-content;
    padding: 10px 20px;
    font-size: 14px;
  }

  .hero-vitrin__cizgiler{
    display: flex;
    gap: 6px;
    margin-top: 12px;
    padding: 0 2px;
  }

  .hero-vitrin__cizgi{
    flex: 1;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hero-vitrin__cizgi-dolgu{
    position: relative;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: rgba(247,243,236,.32);
    overflow: hidden;
  }
  .hero-vitrin__cizgi-dolgu::after{
    content: "";
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform: scaleX(0);
    background: var(--pirinc);
    border-radius: inherit;
  }
  .hero-vitrin__cizgi[aria-selected="true"] .hero-vitrin__cizgi-dolgu::after{
    transform: scaleX(1);
  }
  .hero-vitrin--canli .hero-vitrin__cizgi[aria-selected="true"] .hero-vitrin__cizgi-dolgu::after{
    transition: transform 5s linear;
  }
  .hero-vitrin__cizgi:hover .hero-vitrin__cizgi-dolgu{ background: rgba(247,243,236,.5); }
  .hero-vitrin__cizgi:focus-visible{
    outline: 2px solid var(--pirinc);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* Masaüstü: hero görselinin sağ-alt köşesinde yüzen kompakt kart.
     .hero__icerik bu genişlikte sağ kenara kadar açılır (bkz. global.css),
     böylece right/bottom hero bölümünün kendi kenarına göre hizalanır. */
  @media (min-width: 1360px){
    .hero-vitrin{
      position: absolute;
      right: clamp(20px, 3vw, 44px);
      bottom: clamp(20px, 3vw, 44px);
      width: min(320px, 25vw);
      margin-top: 0;
    }
  }

  @media (max-width: 767px){
    .hero-vitrin{ margin-top: 22px; }
    .hero-vitrin__kart{ height: clamp(280px, 78vw, 340px); }
  }

  @media (prefers-reduced-motion: reduce){
    .hero-vitrin,
    .hero-vitrin__slayt{ animation: none; transition: none; }
    .hero-vitrin__cizgi-dolgu::after{ transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var bolumler = document.querySelectorAll('[data-hero-vitrin]');
    bolumler.forEach(function (bolum) {
      var slaytlar = bolum.querySelectorAll('[data-vitrin-slayt]');
      var cizgiler = bolum.querySelectorAll('[data-vitrin-git]');
      if (slaytlar.length < 2) return;

      var sakin = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var suan = 0;
      var zamanlayici = null;
      var SURE = 5000;

      function goster(index) {
        suan = (index + slaytlar.length) % slaytlar.length;
        slaytlar.forEach(function (sl, i) {
          var aktif = i === suan;
          sl.setAttribute('aria-hidden', aktif ? 'false' : 'true');
          if (aktif) sl.removeAttribute('inert'); else sl.setAttribute('inert', '');
        });
        cizgiler.forEach(function (c, i) {
          c.setAttribute('aria-selected', i === suan ? 'true' : 'false');
        });
      }

      function dur() {
        if (zamanlayici) clearInterval(zamanlayici);
        zamanlayici = null;
        bolum.classList.remove('hero-vitrin--canli');
      }

      function baslat() {
        if (sakin || zamanlayici) return;
        bolum.classList.add('hero-vitrin--canli');
        zamanlayici = setInterval(function () { goster(suan + 1); }, SURE);
      }

      cizgiler.forEach(function (c) {
        c.addEventListener('click', function () {
          dur();
          goster(parseInt(c.getAttribute('data-vitrin-git'), 10));
          baslat();
        });
      });

      bolum.addEventListener('mouseenter', dur);
      bolum.addEventListener('mouseleave', baslat);
      bolum.addEventListener('focusin', dur);
      bolum.addEventListener('focusout', baslat);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) dur(); else baslat();
      });

      goster(0);
      baslat();
    });
  })();
</script>
