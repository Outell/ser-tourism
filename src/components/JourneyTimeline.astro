---
interface StageItem {
  index: number;
  title: string;
  icon: string;
  meta: string | null;
  description: string | null;
  stageLabel: string;
}

interface Props {
  stages: StageItem[];
  nowShowingLabel: string;
}

const { stages, nowShowingLabel } = Astro.props;
---

<ol class="journey-timeline" data-journey-timeline aria-label={nowShowingLabel} style={`--stage-count:${stages.length}`}>
  {stages.map((stage) => (
    <li class="journey-timeline__item">
      <button
        class="journey-timeline__button"
        type="button"
        data-journey-stage={stage.index}
        aria-current={stage.index === 0 ? 'step' : undefined}
        aria-label={`${stage.stageLabel}: ${stage.title}`}
      >
        <span class="journey-timeline__rail" aria-hidden="true"></span>
        <span class="journey-timeline__node" aria-hidden="true">
          <span class="journey-timeline__icon" set:html={stage.icon}></span>
        </span>
        <span class="journey-timeline__copy">
          <span class="journey-timeline__step">{String(stage.index + 1).padStart(2, '0')}</span>
          <strong>{stage.title}</strong>
          {stage.meta && <small>{stage.meta}</small>}
        </span>
      </button>
    </li>
  ))}
</ol>

<style>
  .journey-timeline{
    --timeline-progress: 0%;
    position: relative;
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .journey-timeline::before,
  .journey-timeline::after{
    content: "";
    position: absolute;
    left: 22px;
    top: 22px;
    bottom: 22px;
    width: 2px;
    background: var(--border-strong);
  }
  .journey-timeline::after{
    bottom: auto;
    height: var(--timeline-progress);
    background: linear-gradient(to bottom, var(--action), color-mix(in srgb, var(--action) 48%, var(--border)));
    transition: height .5s cubic-bezier(.16, 1, .3, 1);
  }
  .journey-timeline__item{
    position: relative;
    min-width: 0;
  }
  .journey-timeline__button{
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 15px;
    align-items: center;
    padding: 10px 10px 10px 0;
    border: 1px solid transparent;
    border-radius: var(--r-buton);
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color .2s ease-out, background .2s ease-out, transform .2s ease-out;
  }
  .journey-timeline__rail{
    display: none;
  }
  .journey-timeline__node{
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-elevated);
    color: var(--text-muted);
    box-shadow: 0 10px 24px rgba(20, 18, 36, .06);
    transition: border-color .25s ease-out, color .25s ease-out, transform .25s ease-out, background .25s ease-out;
  }
  .journey-timeline__icon{
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
  }
  .journey-timeline__icon :global(svg){
    width: 20px;
    height: 20px;
    display: block;
  }
  .journey-timeline__copy{
    min-width: 0;
    display: grid;
    gap: 3px;
  }
  .journey-timeline__step{
    color: var(--accent-hover); /* 11px'de düz pirinç 4.5:1'i geçmiyordu */
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .journey-timeline__copy strong{
    overflow-wrap: normal;
    word-break: normal;
    hyphens: manual;
    color: var(--text-primary);
    font-size: 15px;
    line-height: 1.28;
    text-transform: none;
  }
  .journey-timeline__copy small{
    color: var(--text-muted);
    font-size: 12px;
  }
  .journey-timeline__button[aria-current="step"] .journey-timeline__node{
    border-color: color-mix(in srgb, var(--action) 70%, var(--border));
    background: color-mix(in srgb, var(--action) 12%, var(--surface-elevated));
    color: var(--action);
    transform: scale(1.04);
  }
  .journey-timeline__button[aria-current="step"]{
    border-color: color-mix(in srgb, var(--action) 28%, var(--border));
    background: color-mix(in srgb, var(--action) 8%, transparent);
  }
  .journey-timeline__button[data-complete="true"] .journey-timeline__node{
    border-color: color-mix(in srgb, var(--action) 46%, var(--border));
    color: var(--action);
  }
  .journey-timeline__button:hover{
    border-color: color-mix(in srgb, var(--action) 24%, var(--border));
    background: color-mix(in srgb, var(--surface-elevated) 74%, transparent);
  }
  .journey-timeline__button:hover .journey-timeline__node{
    border-color: var(--action);
    color: var(--action);
  }
  .journey-timeline__button:focus-visible{
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: var(--r-buton);
  }
  @media (max-width: 430px){
    .journey-timeline{
      gap: 4px;
    }
    .journey-timeline__button{
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 12px;
      padding-right: 6px;
    }
    .journey-timeline__node{
      width: 42px;
      height: 42px;
    }
    .journey-timeline__copy strong{
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .journey-timeline::after,
    .journey-timeline__node,
    .journey-timeline__button{
      transition: none;
    }
    .journey-timeline__button[aria-current="step"] .journey-timeline__node{
      transform: none;
    }
  }
</style>
