---
import type { Dil } from '../lib/tipler';
import { listelenebilirTurlar, turUrl } from '../lib/rotalar';
import { WA_NUMBERS } from '../config/marka';
import SerLogo from './SerLogo.astro';

interface Props { dil: Dil }
const { dil } = Astro.props;

const metin = {
  tr: {
    aria: 'SER Tourism & Travel seyahat asistanı', badge: 'Seyahat Asistanı', online: 'Çevrimiçi',
    hello: 'Merhaba 👋 Antalya tatilini kolaylaştıralım. Sana uygun turu birkaç soruda bulabilirim.',
    intro: 'Ne yapmak istersin?', recommend: 'Bana tur öner', prices: 'Tur fiyatları', nearest: 'Bana en yakın turlar',
    family: 'Aile için tur', transfer: 'Transfer var mı?', booking: 'Rezervasyon yapmak istiyorum',
    vibe: 'Nasıl bir deneyim arıyorsun?', sea: 'Deniz & tekne', adventure: 'Macera', culture: 'Tarih & kültür', relax: 'Rahat bir gün',
    region: 'Hangi bölgede konaklıyorsun?', regionHint: 'Bölgeni seçersen transfer açısından daha uygun seçenekleri öne çıkarırım.',
    found: 'Sana uygun seçenekleri buldum:', priceIntro: 'Başlangıç fiyatlarına göre öne çıkan turlar:',
    nearestIntro: 'Bu bölgeden transfer sunan seçenekler içinde öne çıkanlar:', familyIntro: 'Aileler için daha rahat seçeneklerden birkaçını seçtim:',
    transferIntro: 'Transfer durumunu kontrol etmek için konakladığın bölgeyi seç.', transferYes: 'Evet — bu turlar seçtiğin bölgeden transfer sunuyor:',
    noResult: 'Bu seçim için net bir eşleşme bulamadım. WhatsApp ekibimiz sana en doğru seçeneği önerebilir.',
