    restart: 'Başa dön', close: 'Kapat', typing: 'SER Tourism & Travel yazıyor…', teaser: 'Kararsız mı kaldın? Sana uygun turu bulabilirim ✨',
    reservePrompt: 'Hangi tur için rezervasyon düşünüyorsun?', waGeneric: 'Merhaba, Antalya turları hakkında bilgi ve rezervasyon desteği almak istiyorum.',
    waTour: 'Merhaba, {tour} için rezervasyon yapmak istiyorum. Müsaitlik ve detayları paylaşabilir misiniz?',
    other: 'Diğer bölgeler / Emin değilim', otherWa: 'Merhaba, konakladığım bölge için uygun transferli turları öğrenmek istiyorum.',
    followUp: 'Başka neye bakmak istersin?'
  },
  en: {
    aria: 'SER Tourism & Travel assistant', badge: 'Travel Assistant', online: 'Online',
    hello: 'Hi 👋 Let’s make your Antalya holiday easier. I can find a suitable tour in a few questions.',
    intro: 'What would you like to do?', recommend: 'Recommend a tour', prices: 'Tour prices', nearest: 'Tours near me',
    family: 'Family-friendly tours', transfer: 'Is transfer included?', booking: 'I want to book',
    vibe: 'What kind of experience are you looking for?', sea: 'Sea & boat', adventure: 'Adventure', culture: 'History & culture', relax: 'Relaxing day',
    region: 'Where are you staying?', regionHint: 'Choose your area and I’ll prioritise tours with convenient transfers.',
    found: 'I found these options for you:', priceIntro: 'Popular tours by starting price:',
    nearestIntro: 'Top options offering transfer from this area:', familyIntro: 'Here are some easier family-friendly options:',
