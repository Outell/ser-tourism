---
// src/components/TurVitrin.astro
//
// Öne çıkan 4 tur için büyük fotoğraf galerisi. Ana sayfada Havalimanı
// Transferi ile Öne Çıkan Hizmetler arasında, tam genişlikte kendi
// bölümü olarak durur (daha önce hero içinde küçük bir "story" kartıydı;
// kullanıcı isteğiyle büyütülüp buraya taşındı).
//
// Her slaytta 1 büyük görsel + aynı turun galerisinden 3 küçük görsel.
// Küçük görsele tıklamak o görseli büyük alanla yer değiştirir (gerçek
// swap — eski büyük görsel tıklanan küçüğün yerine geçer). Sol/sağ ok
// tuşları bir sonraki/önceki TURA geçer; alttaki çizgiler otomatik
// oynatma ilerlemesini gösterir ve tıklanarak doğrudan bir tura gidilir.
//
// Sıra: Adventure Combo → Aksu Dolphin Experience → Jeep Kaizer → Jeep Kaizer Night Safari.

import type { Dil } from '../lib/tipler';
import { sozluk, yerlestir } from '../i18n/sozluk';
import { turBul, turUrl } from '../lib/rotalar';

interface Props { dil: Dil; }
const { dil } = Astro.props;
const s = sozluk[dil];

const ONE_CIKAN_TUR_ID = ['adventure-combo', 'aksu-dolphin-experience', 'jeep-kaiser', 'jeep-kaiser-night-safari'] as const;

const slaytlar = ONE_CIKAN_TUR_ID
  .map((id) => turBul(id))
  .filter((t): t is NonNullable<typeof t> => !!t)
  .map((t) => {
    const havuz = t.galeri?.length ? t.galeri : ([t.kapak].filter(Boolean) as string[]);
    const gorseller = havuz.slice(0, 4);
    return {
      baslik: t.baslik[dil],
      aciklama: t.ozet[dil],
      altMetin: t.alt_metin?.[dil] ?? t.baslik[dil],
      href: turUrl(dil, t),
      buton: s.vitrin_rezervasyon_buton,
      gorseller,
    };
  })
  .filter((sl) => sl.gorseller.length > 0);
---

<section class="kap bolum--dar tur-vitrin" data-tur-vitrin aria-roledescription="carousel" aria-label={s.vitrin_bolum_etiket}>
  <div class="tur-vitrin__viewport">
    {slaytlar.map((sl, i) => (
      <article
        class="tur-vitrin__slayt"
        data-vitrin-slayt
        data-vitrin-gorseller={JSON.stringify(sl.gorseller)}
        aria-hidden={i === 0 ? 'false' : 'true'}
        inert={i === 0 ? undefined : true}
      >
        <div class="tur-vitrin__medya">
          <div class="tur-vitrin__buyuk">
            <img
              class="tur-vitrin__buyuk-gorsel"
              data-vitrin-buyuk-gorsel
              src={sl.gorseller[0]}
              alt={sl.altMetin}
              width="1200" height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="tur-vitrin__golge" aria-hidden="true"></span>
            <div class="tur-vitrin__icerik">
              <h3 class="tur-vitrin__baslik">{sl.baslik}</h3>
              <p class="tur-vitrin__aciklama">{sl.aciklama}</p>
              <a class="buton-govde tur-vitrin__buton" href={sl.href}>{sl.buton}</a>
            </div>
            <button type="button" class="tur-vitrin__ok tur-vitrin__ok--sol" data-vitrin-onceki aria-label={s.vitrin_onceki_tur}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="tur-vitrin__ok tur-vitrin__ok--sag" data-vitrin-sonraki aria-label={s.vitrin_sonraki_tur}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>

          {sl.gorseller.length > 1 && (
            <div class="tur-vitrin__kucukler">
              {sl.gorseller.slice(1, 4).map((g, ki) => (
                <button
                  type="button"
                  class="tur-vitrin__kucuk"
                  data-vitrin-kucuk
                  aria-label={`${sl.baslik} ${ki + 2}`}
                >
                  <img data-vitrin-kucuk-gorsel src={g} alt="" width="400" height="400" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="tur-vitrin__cizgiler" role="tablist" aria-label={s.vitrin_bolum_etiket}>
    {slaytlar.map((_, i) => (
      <button
        type="button"
        class="tur-vitrin__cizgi"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        data-vitrin-git={i}
        aria-label={yerlestir(s.vitrin_slayt_git, { n: i + 1 })}
      >
        <span class="tur-vitrin__cizgi-dolgu"></span>
      </button>
    ))}
  </div>
</section>

<style>
  .tur-vitrin{ position: relative; }

  /* Slaytlar viewport içinde mutlak konumla üst üste biner (kart tarzı
     çapraz geçiş). Viewport'a SABİT bir yükseklik veriyoruz ki .tur-vitrin
     ölçüsü içerikten değil bu değerden gelsin — aksi halde slaytlar
     arası geçişte yükseklik oynayıp alttaki bölümlerle iç içe geçiyordu. */
  .tur-vitrin__viewport{
    position: relative;
    height: clamp(360px, 40vw, 500px);
    border-radius: var(--r-kart);
  }

  .tur-vitrin__slayt{
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity .5s ease-out;
    pointer-events: none;
  }
  .tur-vitrin__slayt[aria-hidden="false"]{
    opacity: 1;
    pointer-events: auto;
  }

  .tur-vitrin__medya{
    display: grid;
    grid-template-columns: 1fr minmax(150px, 240px);
    /* "1fr" (auto değil) satır: küçük görsel sütunundaki img'lerin kendi
       en-boy oranından doğan içerik yüksekliği satırı büyütüp büyük
       görseli taşırıyordu (yükseklik sabit görünse de içerik satırı
       kendi payını content-size'a göre hesaplıyordu). 1fr, satırı doğrudan
       medya'nın height'ına eşitliyor. */
    grid-template-rows: minmax(0, 1fr);
    gap: 12px;
    height: 100%;
  }

  .tur-vitrin__buyuk{
    position: relative;
    height: 100%;
    border-radius: var(--r-kart);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow: var(--shadow-lg);
  }

  .tur-vitrin__buyuk-gorsel{
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }

  .tur-vitrin__golge{
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8,11,22,.90) 0%, rgba(8,11,22,.48) 45%, rgba(8,11,22,.04) 76%);
    pointer-events: none;
  }

  .tur-vitrin__icerik{
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: grid;
    gap: 8px;
    padding: clamp(18px, 3vw, 32px);
    max-width: 560px;
  }

  .tur-vitrin__baslik{
    margin: 0;
    color: var(--beyaz);
    font-family: var(--font-baslik);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.1;
  }

  .tur-vitrin__aciklama{
    margin: 0 0 6px;
    color: rgba(247,243,236,.88);
    font-size: clamp(13.5px, 1.2vw, 15px);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tur-vitrin__buton{
    width: max-content;
    padding: 11px 22px;
    font-size: 14px;
  }

  .tur-vitrin__kucukler{
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: 12px;
    height: 100%;
  }

  .tur-vitrin__kucuk{
    position: relative;
    border: 0;
    padding: 0;
    border-radius: var(--r-media);
    overflow: hidden;
    cursor: pointer;
    background: var(--surface-strong);
  }
  .tur-vitrin__kucuk img{
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .35s ease-out;
  }
  .tur-vitrin__kucuk:hover img,
  .tur-vitrin__kucuk:focus-visible img{
    transform: scale(1.06);
  }
  .tur-vitrin__kucuk:focus-visible{
    outline: 2px solid var(--pirinc);
    outline-offset: 2px;
  }

  .tur-vitrin__ok{
    position: absolute;
    top: 40%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px; height: 48px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: background-color .18s ease, transform .18s ease, color .18s ease;
    transform: translateY(-50%);
  }
  .tur-vitrin__ok--sol{ left: clamp(10px, 2vw, 20px); }
  .tur-vitrin__ok--sag{ right: clamp(10px, 2vw, 20px); }
  .tur-vitrin__ok svg{ width: 20px; height: 20px; }
  .tur-vitrin__ok:hover{
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .tur-vitrin__ok:active{ transform: translateY(-50%) scale(.94); }
  .tur-vitrin__ok:focus-visible{
    outline: 2px solid var(--pirinc);
    outline-offset: 2px;
  }

  .tur-vitrin__cizgiler{
    display: flex;
    gap: 6px;
    margin-top: 16px;
    padding: 0 clamp(0px, 4vw, 68px);
  }

  .tur-vitrin__cizgi{
    flex: 1;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .tur-vitrin__cizgi-dolgu{
    position: relative;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: var(--border-strong);
    overflow: hidden;
  }
  .tur-vitrin__cizgi-dolgu::after{
    content: "";
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform: scaleX(0);
    background: var(--pirinc);
    border-radius: inherit;
  }
  .tur-vitrin__cizgi[aria-selected="true"] .tur-vitrin__cizgi-dolgu::after{
    transform: scaleX(1);
  }
  .tur-vitrin--canli .tur-vitrin__cizgi[aria-selected="true"] .tur-vitrin__cizgi-dolgu::after{
    transition: transform 5.5s linear;
  }
  .tur-vitrin__cizgi:hover .tur-vitrin__cizgi-dolgu{ background: var(--text-muted); }
  .tur-vitrin__cizgi:focus-visible{
    outline: 2px solid var(--pirinc);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 767px){
    /* Viewport'un mobil yüksekliği de sabit: büyük görsel + boşluk + küçük
       görsel sırası toplamı — içerikten değil bu hesaptan gelir (yukarıdaki
       nota bakınız). */
    .tur-vitrin__viewport{
      height: calc(clamp(260px, 82vw, 380px) + 12px + clamp(80px, 22vw, 110px));
    }
    .tur-vitrin__medya{
      grid-template-columns: 1fr;
      grid-template-rows: clamp(260px, 82vw, 380px) clamp(80px, 22vw, 110px);
      height: 100%;
    }
    .tur-vitrin__buyuk{ height: 100%; }
    .tur-vitrin__kucukler{
      grid-template-rows: none;
      grid-template-columns: repeat(3, 1fr);
      height: 100%;
    }
    .tur-vitrin__ok{ top: 36%; width: 44px; height: 44px; }
    .tur-vitrin__ok svg{ width: 18px; height: 18px; }
    .tur-vitrin__ok--sol{ left: 10px; }
    .tur-vitrin__ok--sag{ right: 10px; }
    .tur-vitrin__cizgiler{ padding: 0; }
  }

  @media (max-width: 420px){
    .tur-vitrin__aciklama{ -webkit-line-clamp: 3; }
  }

  @media (prefers-reduced-motion: reduce){
    .tur-vitrin__slayt,
    .tur-vitrin__kucuk img{ transition: none; }
    .tur-vitrin__cizgi-dolgu::after{ transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var bolumler = document.querySelectorAll('[data-tur-vitrin]');
    bolumler.forEach(function (bolum) {
      var slaytlar = bolum.querySelectorAll('[data-vitrin-slayt]');
      var cizgiler = bolum.querySelectorAll('[data-vitrin-git]');
      var oncekiBtnlar = bolum.querySelectorAll('[data-vitrin-onceki]');
      var sonrakiBtnlar = bolum.querySelectorAll('[data-vitrin-sonraki]');
      if (slaytlar.length < 1) return;

      // Her slayt için orijinal galeri sırasını sakla; slayt her devreye
      // girdiğinde büyük/küçük görseller bu sıraya sıfırlanır.
      slaytlar.forEach(function (sl) {
        try {
          sl._vitrinOrijinal = JSON.parse(sl.getAttribute('data-vitrin-gorseller') || '[]');
        } catch (e) {
          sl._vitrinOrijinal = [];
        }
        sl._vitrinSira = sl._vitrinOrijinal.slice();
      });

      function gorselleriCiz(sl) {
        var buyuk = sl.querySelector('[data-vitrin-buyuk-gorsel]');
        var kucukler = sl.querySelectorAll('[data-vitrin-kucuk]');
        var sira = sl._vitrinSira;
        if (buyuk && sira[0]) buyuk.src = sira[0];
        kucukler.forEach(function (btn, i) {
          var img = btn.querySelector('[data-vitrin-kucuk-gorsel]');
          if (img && sira[i + 1]) img.src = sira[i + 1];
        });
      }

      function kucukTikla(sl, index) {
        var sira = sl._vitrinSira;
        var geciciBuyuk = sira[0];
        sira[0] = sira[index];
        sira[index] = geciciBuyuk;
        gorselleriCiz(sl);
      }

      slaytlar.forEach(function (sl) {
        var kucukler = sl.querySelectorAll('[data-vitrin-kucuk]');
        kucukler.forEach(function (btn, i) {
          btn.addEventListener('click', function () {
            kucukTikla(sl, i + 1);
          });
        });
      });

      if (slaytlar.length < 2) {
        oncekiBtnlar.forEach(function (b) { b.style.display = 'none'; });
        sonrakiBtnlar.forEach(function (b) { b.style.display = 'none'; });
        var tekCizgiler = bolum.querySelector('.tur-vitrin__cizgiler');
        if (tekCizgiler) tekCizgiler.style.display = 'none';
        return;
      }

      var sakin = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var suan = 0;
      var zamanlayici = null;
      var SURE = 5500;

      function goster(index) {
        var eski = suan;
        suan = (index + slaytlar.length) % slaytlar.length;
        slaytlar.forEach(function (sl, i) {
          var aktif = i === suan;
          sl.setAttribute('aria-hidden', aktif ? 'false' : 'true');
          if (aktif) sl.removeAttribute('inert'); else sl.setAttribute('inert', '');
          // Ayrılan slaytı bir sonraki gelişte orijinal fotoğraf sırasına döndür.
          if (i === eski && !aktif && eski !== suan) {
            sl._vitrinSira = sl._vitrinOrijinal.slice();
            gorselleriCiz(sl);
          }
        });
        cizgiler.forEach(function (c, i) {
          c.setAttribute('aria-selected', i === suan ? 'true' : 'false');
        });
      }

      function dur() {
        if (zamanlayici) clearInterval(zamanlayici);
        zamanlayici = null;
        bolum.classList.remove('tur-vitrin--canli');
      }

      function baslat() {
        if (sakin || zamanlayici) return;
        bolum.classList.add('tur-vitrin--canli');
        zamanlayici = setInterval(function () { goster(suan + 1); }, SURE);
      }

      cizgiler.forEach(function (c) {
        c.addEventListener('click', function () {
          dur();
          goster(parseInt(c.getAttribute('data-vitrin-git'), 10));
          baslat();
        });
      });

      oncekiBtnlar.forEach(function (b) {
        b.addEventListener('click', function () {
          dur();
          goster(suan - 1);
          baslat();
        });
      });
      sonrakiBtnlar.forEach(function (b) {
        b.addEventListener('click', function () {
          dur();
          goster(suan + 1);
          baslat();
        });
      });

      bolum.addEventListener('mouseenter', dur);
      bolum.addEventListener('mouseleave', baslat);
      bolum.addEventListener('focusin', dur);
      bolum.addEventListener('focusout', baslat);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) dur(); else baslat();
      });

      goster(0);
      baslat();
    });
  })();
</script>
